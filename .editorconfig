# .editorconfig
# 统一编辑器配置

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python backend
[backend/**.py]
indent_style = space
indent_size = 4
max_line_length = 100

# Python configuration files
[{backend/**.toml,backend/**.cfg,backend/**.ini}]
indent_style = space
indent_size = 4

# TypeScript/JavaScript frontend
[frontend/**.{ts,tsx,js,jsx}]
indent_style = space
indent_size = 2
max_line_length = 100

# JSON files
[frontend/**.json]
indent_style = space
indent_size = 2

# CSS/SCSS
[frontend/**.{css,scss}]
indent_style = space
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2
end_of_line = lf
