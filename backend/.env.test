# Test environment variables
# Copy this file to .env.test and configure for your environment

# Database - Test database (using same server as dev, different db name)
DATABASE_URL=postgresql+asyncpg://agent_skills_user:your_secure_password_here@localhost:5432/agent_skills_test
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agent_skills_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=agent_skills_test

# JWT - Use a simple test key
SECRET_KEY=test-secret-key-for-testing-only-not-for-production
