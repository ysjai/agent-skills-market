# Database Configuration
POSTGRES_HOST=localhost
# 仅在执行 `just postgres-up`、把 Docker 中的 PostgreSQL 暴露到宿主机时使用
POSTGRES_PORT=5432
POSTGRES_USER=agent_skills_user
POSTGRES_PASSWORD=change_this_to_secure_password
POSTGRES_DB=agent_skills

# Full database URL for SQLAlchemy (asyncpg driver)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://agent_skills_user:change_this_to_secure_password@localhost:5432/agent_skills

# Docker Compose 中后端容器使用的数据库连接。
# 留空时默认连接 docker-compose.yml 里的本地 postgres 服务。
# 如果要改连云数据库，请在这里填写完整连接串（通常还需要 ?ssl=require）。
# DOCKER_DATABASE_URL=postgresql+asyncpg://agent_skills_user:change_this_to_secure_password@your-cloud-host:5432/agent_skills?ssl=require

# Frontend 公开 API 地址。
# 通过 Nginx 网关或 Next.js 开发代理时，推荐保持为相对路径。
NEXT_PUBLIC_API_URL=/api

# 仅在直接运行 frontend 开发服务器时使用，把 /api 代理到后端。
# just run-frontend / just dev 会自动注入这个值。
# API_PROXY_TARGET=http://127.0.0.1:8000/api

# Backend CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# 可选：用于支持 Vercel Preview 等动态域名，例如：
# ALLOWED_ORIGIN_REGEX=^https://.*\.vercel\.app$
# 生产环境通常会把正式域名放在 ALLOWED_ORIGINS，把预览域名放在这里。
# ALLOWED_ORIGIN_REGEX=

# Docker 网关对外暴露端口
GATEWAY_PORT=8080

# 手动本机开发时使用的前后端端口
BACKEND_PORT=8000
FRONTEND_PORT=3000

# JWT Secret Key (可选)
# 开发环境：不设置则自动生成（会话不持久化）
# 生产环境：必须设置！使用以下命令生成：
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# 环境标识 (development | production | testing)
# development: 开发环境，SECRET_KEY 自动生成
# production: 生产环境，必须设置 SECRET_KEY
# testing: 测试环境
ENVIRONMENT=development
